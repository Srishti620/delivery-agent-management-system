# Optional. Copy to `.env` only if you need to change the defaults. Nothing here is secret
# (Vite embeds VITE_* values in the public bundle, so never put credentials in them).

# Where the dev server proxies /api requests (default: http://localhost:5000)
VITE_PROXY_TARGET=http://localhost:5000

# Production builds: absolute API URL if the API is served from a different origin than the frontend.
# Leave unset to call the relative path /api (e.g. when a reverse proxy serves both).
# VITE_API_BASE_URL=https://api.example.com/api
