# Copy this file to `.env` and adjust. `.env` is git-ignored; never commit real credentials.

NODE_ENV=development
PORT=5000

# MongoDB connection string. For hosted databases (e.g. Atlas) this contains a password,
# so keep it only in your local .env or your hosting provider's secret store.
MONGODB_URI=mongodb://127.0.0.1:27017/delivery_agents

# Redis connection string (use rediss:// for TLS, redis://:password@host:6379 for auth).
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Caching
CACHE_ENABLED=true
CACHE_PREFIX=dams
CACHE_DETAIL_TTL_SECONDS=300
CACHE_LIST_TTL_SECONDS=60
